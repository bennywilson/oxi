// OXI 2026
// Post-process outlines. Outlined meshes render custom depth and write a custom stencil value that indexes the style palette.

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"

#ifndef OUTLINE_16_DIRECTIONS
#define OUTLINE_16_DIRECTIONS 0
#endif

#ifndef OUTLINE_SMEAR
#define OUTLINE_SMEAR 0
#endif


// Mirrors FOxiOutlineStyleGPU.
struct FOxiOutlineStyle
{
	float4 ColorDim;		// rgb line color, a dim amount
	float4 EmissiveFloor;	// rgb emissive, a minimum brightness when dimmed
	float4 Width;			// x width (px @ reference height), y width at far distance, z interior line scale, w opacity
	float4 Misc;			// x focus influence, yzw unused
	uint4 Flags;			// x flags
};

#define OUTLINE_FLAG_ENABLED		1
#define OUTLINE_FLAG_THROUGH_WALLS	2
#define OUTLINE_FLAG_INTERIOR		4

Texture2D InputSceneColor;
StructuredBuffer<FOxiOutlineStyle> Styles;
int4 ViewRect;				// min.xy, max.xy (exclusive), in scene texture pixels
float2 DistanceFalloff;		// near depth, 1 / (far - near)
float2 SelfOverlap;			// depth gap: constant, per depth per pixel of distance
float2 OcclusionBias;		// visibility slack: constant, per depth
float4 FocusColor;			// rgb focus color, a emissive intensity
float FocusAmount;			// 0 = styles keep their own color, 1 = fully focused
float WidthScale;			// view height / reference height
float MaxWidth;				// cap on authored width (px @ reference height)
float SearchRadius;			// px, largest distance at which any line can cover a pixel

// One dash trail. The gameplay side starts these; the renderer projects the dash into screen space per view.
struct FOxiSmearInstance
{
	float4 StartEnd;	// xy where the trail starts, zw where the object is now, both in pixels
	float4 Params;		// x falloff, y opacity, z radius (px), w strength
	float4 Depths;		// x view depth at the start, y at the object, z taper, w unused
	float4 Bounds;		// screen rect (min.xy, max.xy) the trail can touch, so other pixels skip it cheaply
	uint4 Stencil;		// x stencil value this trail belongs to
};

StructuredBuffer<FOxiSmearInstance> Smears;
int NumSmears;

Texture2D OutlineTexture;

// Integer steps so every sample lands on a pixel center. Diagonals/knight moves step further per iteration.
#if OUTLINE_16_DIRECTIONS
#define NUM_DIRECTIONS 16
static const int2 Directions[NUM_DIRECTIONS] =
{
	int2( 1, 0), int2( 2, 1), int2( 1, 1), int2( 1, 2),
	int2( 0, 1), int2(-1, 2), int2(-1, 1), int2(-2, 1),
	int2(-1, 0), int2(-2,-1), int2(-1,-1), int2(-1,-2),
	int2( 0,-1), int2( 1,-2), int2( 1,-1), int2( 2,-1),
};
#else
#define NUM_DIRECTIONS 8
static const int2 Directions[NUM_DIRECTIONS] =
{
	int2( 1, 0), int2( 1, 1), int2( 0, 1), int2(-1, 1),
	int2(-1, 0), int2(-1,-1), int2( 0,-1), int2( 1,-1),
};
#endif

struct FOutlineSample
{
	uint Stencil;
	float CustomDepth;
	float SceneDepth;
};

uint LoadStencil(int2 PixelPos)
{
	return SceneTexturesStruct.CustomStencilTexture.Load(int3(PixelPos, 0)) STENCIL_COMPONENT_SWIZZLE;
}

FOutlineSample LoadDepths(int2 PixelPos, uint Stencil)
{
	FOutlineSample Sample;
	Sample.Stencil = Stencil;
	Sample.CustomDepth = ConvertFromDeviceZ(SceneTexturesStruct.CustomDepthTexture.Load(int3(PixelPos, 0)).r);
	Sample.SceneDepth = ConvertFromDeviceZ(SceneTexturesStruct.SceneDepthTexture.Load(int3(PixelPos, 0)).r);
	return Sample;
}

bool IsStyleEnabled(uint Stencil)
{
	return Stencil != 0 && (Styles[Stencil].Flags.x & OUTLINE_FLAG_ENABLED) != 0;
}

float GetBias(float Depth)
{
	return OcclusionBias.x + OcclusionBias.y * Depth;
}

// True when the outlined surface in custom depth is what the camera actually sees at this pixel.
bool IsCustomDepthVisible(FOutlineSample Sample)
{
	return Sample.CustomDepth <= Sample.SceneDepth + GetBias(Sample.CustomDepth);
}

float GetLineWidth(FOxiOutlineStyle Style, float Depth)
{
	const float T = smoothstep(0.0, 1.0, saturate((Depth - DistanceFalloff.x) * DistanceFalloff.y));
	return min(lerp(Style.Width.x, Style.Width.y, T), MaxWidth) * WidthScale;
}

// Ink for a style: the aim-focus tint, then dimming by the lighting on the object being outlined.
// SourcePos is a pixel on that object, which is where the lighting is read from.
void GetStyleInk(FOxiOutlineStyle Style, int2 SourcePos, out float3 OutInk, out float3 OutEmissive)
{
	const float Focus = saturate(FocusAmount * Style.Misc.x);
	OutInk = lerp(Style.ColorDim.rgb, FocusColor.rgb, Focus);

	// Dim by how lit the object is right there: displayed scene color relative to its albedo.
	if (Style.ColorDim.a > 0.0)
	{
		const float2 BufferUV = (float2(SourcePos) + 0.5) * View.BufferSizeAndInvSize.zw;
		const float BaseLuminance = Luminance(GetGBufferData(BufferUV).BaseColor);
		const float SceneLuminance = Luminance(InputSceneColor.Load(int3(SourcePos, 0)).rgb);

		// Near-black albedo gives no usable lighting estimate; leave the ink undimmed.
		const float Lighting = BaseLuminance > 0.02 ? saturate(SceneLuminance / BaseLuminance) : 1.0;
		OutInk *= lerp(1.0, max(Lighting, Style.EmissiveFloor.a), Style.ColorDim.a);
	}

	// Same units as material emissive, so values/bloom behave like an emissive material would.
	// The focus color can add its own glow, so a highlight can ramp up as the player aims.
	OutEmissive = (Style.EmissiveFloor.rgb + FocusColor.rgb * FocusColor.a * Focus) * View.PreExposure;
}

#if OUTLINE_SMEAR
// Ink trailing a moving or dashing object. The object is not in any buffer along its trail - it teleported, or it
// has already moved on - so the trail is drawn as the region it swept: the capsule between where it was and where
// it is now. Searching the stencil buffer for it instead would step straight over anything small, like a casing.
float4 ComputeSmear(int2 PixelPos, FOutlineSample Center, uint CenterStencil, bool bCenterVisible)
{
	float4 Result = 0;
	const float2 Pixel = float2(PixelPos) + 0.5;

	LOOP
	for (int Index = 0; Index < NumSmears; ++Index)
	{
		const FOxiSmearInstance Smear = Smears[Index];

		// Most pixels are nowhere near a given trail, and several objects can be smearing at once.
		if (any(Pixel < Smear.Bounds.xy) || any(Pixel > Smear.Bounds.zw))
		{
			continue;
		}

		// The object covers this pixel itself, so it is drawn normally rather than smeared.
		if (bCenterVisible && CenterStencil == Smear.Stencil.x)
		{
			continue;
		}

		const float2 Start = Smear.StartEnd.xy;
		const float2 Segment = Smear.StartEnd.zw - Start;
		const float Along = saturate(dot(Pixel - Start, Segment) / max(dot(Segment, Segment), 0.0001));
		const float DistanceToTrail = length(Pixel - (Start + Segment * Along));

		// Narrower at the far end, the way an inked smear tapers off behind what left it.
		const float Radius = Smear.Params.z * lerp(Smear.Depths.z, 1.0, Along);
		const float Edge = saturate(Radius - DistanceToTrail + 0.5);
		if (Edge <= 0.0)
		{
			continue;
		}

		// Geometry in front of the trail hides it.
		const float TrailDepth = lerp(Smear.Depths.x, Smear.Depths.y, Along);
		if (Center.SceneDepth < TrailDepth - GetBias(TrailDepth))
		{
			continue;
		}

		// Lighting for the ink is read where the object is, since the trail itself sits over other geometry.
		const int2 InkSource = clamp(int2(Smear.StartEnd.zw), ViewRect.xy, ViewRect.zw - 1);
		float3 Ink, Emissive;
		GetStyleInk(Styles[Smear.Stencil.x], InkSource, Ink, Emissive);

		const float Fade = pow(Along, Smear.Params.x) * Smear.Params.y * Smear.Params.w * Edge;
		const float4 Tail = float4(Fade * (Ink + Emissive), Fade);
		Result = Tail.a > Result.a ? Tail : Result;
	}

	return Result;
}
#endif

void OutlinePS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const int2 PixelPos = int2(SvPosition.xy);
	const FOutlineSample Center = LoadDepths(PixelPos, LoadStencil(PixelPos));

	const uint CenterStencil = IsStyleEnabled(Center.Stencil) ? Center.Stencil : 0;
	const bool bCenterVisible = CenterStencil != 0 && IsCustomDepthVisible(Center);

	float BestCoverage = 0.0;
	float BestDepth = 0.0;
	uint BestStencil = 0;
	int2 BestPos = PixelPos;

	UNROLL
	for (uint DirIndex = 0; DirIndex < NUM_DIRECTIONS; ++DirIndex)
	{
		const int2 Step = Directions[DirIndex];
		const float StepLength = length(float2(Step));

		LOOP
		for (float Distance = StepLength, StepCount = 1.0; Distance < SearchRadius; Distance += StepLength, StepCount += 1.0)
		{
			const int2 SamplePos = clamp(PixelPos + Step * int(StepCount), ViewRect.xy, ViewRect.zw - 1);
			const uint Stencil = LoadStencil(SamplePos);
			if (!IsStyleEnabled(Stencil))
			{
				continue;
			}

			const FOxiOutlineStyle Style = Styles[Stencil];
			const FOutlineSample Sample = LoadDepths(SamplePos, Stencil);
			const bool bThroughWalls = (Style.Flags.x & OUTLINE_FLAG_THROUGH_WALLS) != 0;

			if (!bThroughWalls && !IsCustomDepthVisible(Sample))
			{
				// This part of the object is hidden; a farther sample in this direction may still be visible.
				continue;
			}

			bool bInterior = false;
			if (bCenterVisible || (bThroughWalls && CenterStencil != 0))
			{
				// Both pixels are outlined surfaces (for through-walls styles, possibly hidden ones), so compare custom depths.
				// The nearer one draws its line over the farther one. Where two styles touch at similar depth,
				// the higher stencil value owns the line so only one side draws it.
				const float DepthGap = Center.CustomDepth - Sample.CustomDepth;
				const float Threshold = SelfOverlap.x + SelfOverlap.y * Sample.CustomDepth * Distance;
				const bool bSameStyle = Stencil == CenterStencil;
				if (DepthGap > Threshold)
				{
					// Self-overlap (arm over torso) is an interior line; a different style in front is a silhouette.
					bInterior = bSameStyle;
				}
				else if (!bSameStyle && abs(DepthGap) <= Threshold && Stencil > CenterStencil)
				{
					bInterior = true;
				}
				else
				{
					continue;
				}

				if (bInterior && (Style.Flags.x & OUTLINE_FLAG_INTERIOR) == 0)
				{
					continue;
				}
			}
			else if (!bThroughWalls && Center.SceneDepth < Sample.CustomDepth - GetBias(Sample.CustomDepth))
			{
				// Silhouette over something un-outlined that is in front of the object, so it hides the line.
				break;
			}

			float Width = GetLineWidth(Style, Sample.CustomDepth);
			if (bInterior)
			{
				Width *= Style.Width.z;
			}

			// The object's edge sits half a pixel from the sample center, so this pixel is (Distance - 0.5) px outside it.
			// Coverage ramps over one pixel for an anti-aliased line edge.
			const float Coverage = saturate(Width - Distance + 1.0);
			if (Coverage > BestCoverage || (Coverage == BestCoverage && Coverage > 0.0 && Sample.CustomDepth < BestDepth))
			{
				BestCoverage = Coverage;
				BestDepth = Sample.CustomDepth;
				BestStencil = Stencil;
				BestPos = SamplePos;
			}

			// Nearest outlined sample in this direction decides; anything beyond it is behind its silhouette.
			break;
		}
	}

	float4 Line = 0;
	if (BestCoverage > 0.0)
	{
		const FOxiOutlineStyle Style = Styles[BestStencil];
		const float Opacity = Style.Width.w;

		float3 Ink, Emissive;
		GetStyleInk(Style, BestPos, Ink, Emissive);

		Line = float4(BestCoverage * (Ink * Opacity + Emissive), BestCoverage * Opacity);
	}

#if OUTLINE_SMEAR
	const float4 Tail = ComputeSmear(PixelPos, Center, CenterStencil, bCenterVisible);
#else
	const float4 Tail = 0;
#endif

	// Lines sit on top of the tail; both are premultiplied.
	OutColor = float4(Line.rgb + Tail.rgb * (1.0 - Line.a), Line.a + Tail.a * (1.0 - Line.a));
}

void CompositePS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	OutColor = OutlineTexture.Load(int3(SvPosition.xy, 0));
}
